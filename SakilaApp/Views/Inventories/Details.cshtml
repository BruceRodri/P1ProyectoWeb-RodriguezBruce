@model SakilaApp.Models.Inventory
@{
    ViewData["Title"] = "Detalles del Inventario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="mb-0 text-center"><i class="fas fa-barcode me-2"></i>DETALLES DE EXISTENCIA</h3>
                </div>

                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex p-4">
                            <div class="col-sm-4 fw-bold text-muted text-uppercase small">ID Inventario</div>
                            <div class="col-sm-8 fs-5 text-dark">#@Model.InventoryId</div>
                        </div>

                        <div class="list-group-item d-flex p-4 bg-light">
                            <div class="col-sm-4 fw-bold text-muted text-uppercase small">Película</div>
                            <div class="col-sm-8">
                                <span class="badge bg-info text-dark fs-6 px-3">
                                    <i class="fas fa-film me-2"></i>@(Model.Film?.Title ?? "CARGANDO...")
                                </span>
                            </div>
                        </div>

                        <div class="list-group-item d-flex p-4">
                            <div class="col-sm-4 fw-bold text-muted text-uppercase small">Ubicación (Tienda)</div>
                            <div class="col-sm-8 fs-5 text-primary">
                                <i class="fas fa-store me-2"></i>Sucursal #@Model.StoreId
                            </div>
                        </div>

                        <div class="list-group-item d-flex p-4">
                            <div class="col-sm-4 fw-bold text-muted text-uppercase small">Último Movimiento</div>
                            <div class="col-sm-8 text-muted italic">
                                <i class="fas fa-calendar-alt me-2"></i>@Model.LastUpdate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-4 border-0 text-center">
                    <div class="d-grid gap-2 d-md-block">
                        <a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn btn-warning px-5 fw-bold shadow-sm">
                            <i class="fas fa-edit me-1"></i> EDITAR ESTE REGISTRO
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-5">
                            <i class="fas fa-arrow-left me-1"></i> VOLVER AL LISTADO
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>