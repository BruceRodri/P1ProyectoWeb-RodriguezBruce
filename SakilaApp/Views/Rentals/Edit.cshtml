@model SakilaApp.Models.Rental
@{
    ViewData["Title"] = "Editar alquiler";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-dark text-white p-3 rounded-top-4">
                <h3 class="mb-0"><i class="fas fa-key me-2"></i>EDITAR TRANSACCIÓN DE ALQUILER</h3>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="RentalId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RentalDate" class="form-label fw-bold">FECHA DE RENTA</label>
                            <input asp-for="RentalDate" class="form-control" type="datetime-local" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReturnDate" class="form-label fw-bold">FECHA DE DEVOLUCIÓN</label>
                            <input asp-for="ReturnDate" class="form-control" type="datetime-local" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label fw-bold">CLIENTE</label>
                        <select asp-for="CustomerId" class="form-select border-primary shadow-sm" asp-items="ViewBag.CustomerId"></select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="InventoryId" class="form-label fw-bold">ID INVENTARIO</label>
                            <select asp-for="InventoryId" class="form-select" asp-items="ViewBag.InventoryId"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffId" class="form-label fw-bold text-danger">EMPLEADO RESPONSABLE</label>
                            <select asp-for="StaffId" class="form-select border-danger" asp-items="ViewBag.StaffId"></select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning px-4 fw-bold">
                            <i class="fas fa-save me-1"></i> GUARDAR CAMBIOS
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>