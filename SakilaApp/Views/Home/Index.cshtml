@model IEnumerable<SakilaApp.Models.Rental>
@{
    ViewData["Title"] = "Inicio - Sistema Sakila";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Bienvenido al Sistema de Gestión Sakila</h1>
            <p class="text-muted">Resumen general de la base de datos y movimientos recientes.</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary">Películas</h5>
                    <p class="display-6 fw-bold">@ViewBag.TotalFilms</p>
                    <small class="text-muted">Catálogo disponible</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-success">Clientes</h5>
                    <p class="display-6 fw-bold">@ViewBag.TotalCustomers</p>
                    <small class="text-muted">Usuarios activos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-warning">Alquileres</h5>
                    <p class="display-6 fw-bold">@ViewBag.TotalRentals</p>
                    <small class="text-muted">Total de registros</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-info">Tiendas</h5>
                    <p class="display-6 fw-bold">@ViewBag.TotalStores</p>
                    <small class="text-muted">Sucursales</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Últimos Alquileres</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID Renta</th>
                                <th>Fecha</th>
                                <th>ID Cliente</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.RentalId</td>
                                    <td>@item.RentalDate.ToShortDateString()</td>
                                    <td>@item.CustomerId</td>
                                    <td><span class="badge bg-success">Activo</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>