@model SakilaApp.Models.Customer
@{
    ViewData["Title"] = "Detalles del cliente";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0"><i class="fas fa-info-circle me-2"></i>PERFIL DEL CLIENTE</h2>
                <span class="badge @(Model.Active ? "bg-light text-success" : "bg-danger") fs-6 px-3 py-2">
                    @(Model.Active ? "ACTIVO" : "INACTIVO")
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex p-3">
                    <div class="col-sm-3 fw-bold text-muted">ID CLIENTE</div>
                    <div class="col-sm-9 text-dark">#@Model.CustomerId</div>
                </div>
                <div class="list-group-item d-flex p-3">
                    <div class="col-sm-3 fw-bold text-muted">NOMBRE COMPLETO</div>
                    <div class="col-sm-9 text-dark">@Model.FirstName @Model.LastName</div>
                </div>
                <div class="list-group-item d-flex p-3">
                    <div class="col-sm-3 fw-bold text-muted">CORREO ELECTRÓNICO</div>
                    <div class="col-sm-9 text-primary">@Model.Email</div>
                </div>
                <div class="list-group-item d-flex p-3 bg-light">
                    <div class="col-sm-3 fw-bold text-muted">FECHA DE REGISTRO</div>
                    <div class="col-sm-9 text-dark">@Model.CreateDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white p-4 border-0 text-end">
            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-warning px-4 fw-bold">
                <i class="fas fa-edit me-1"></i> IR A EDITAR
            </a>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="fas fa-arrow-left me-1"></i> VOLVER AL LISTADO
            </a>
        </div>
    </div>
</div>