@model SakilaApp.Models.Customer
@{
    ViewData["Title"] = "Editar cliente";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-dark text-white p-3 rounded-top-4">
                <h3 class="mb-0"><i class="fas fa-user-edit me-2"></i>EDITAR INFORMACIÓN DEL CLIENTE</h3>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="CustomerId" />
                    <input type="hidden" asp-for="CreateDate" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label fw-bold">NOMBRE</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label fw-bold">APELLIDO</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">CORREO ELECTRÓNICO</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StoreId" class="form-label fw-bold text-primary">TIENDA</label>
                            <select asp-for="StoreId" class="form-select border-primary shadow-sm" asp-items="ViewBag.StoreId"></select>
                            <span asp-validation-for="StoreId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AddressId" class="form-label fw-bold text-primary">ID DE DIRECCIÓN</label>
                            <select asp-for="AddressId" class="form-select border-primary shadow-sm" asp-items="ViewBag.AddressId"></select>
                            <span asp-validation-for="AddressId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="Active" class="form-check-input" type="checkbox" role="switch" id="activeSwitch">
                        <label class="form-check-label fw-bold" for="activeSwitch">¿CLIENTE ACTIVO?</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 fw-bold">
                            <i class="fas fa-sync-alt me-1"></i> ACTUALIZAR
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}