<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - SakilaApp</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --primary-color: #4361ee;
                --dark-bg: #1e1e2d;
                --light-gray: #f8f9fc;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--light-gray);
                color: #333;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* NAVBAR CON EFECTO MODERNO */
            .navbar {
                background-color: rgba(30, 30, 45, 0.98) !important;
                backdrop-filter: blur(10px);
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                padding: 0.7rem 1rem;
            }

            .navbar-brand {
                font-weight: 600;
                letter-spacing: 1px;
                color: #fff !important;
            }

            .nav-link {
                font-weight: 300;
                font-size: 0.9rem;
                transition: all 0.3s ease;
                margin: 0 3px;
                color: rgba(255,255,255,0.8) !important;
            }

                .nav-link:hover {
                    color: var(--primary-color) !important;
                    transform: translateY(-2px);
                }

            /* CONTENEDOR PRINCIPAL ELEGANTE */
            .main-container {
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.04);
                padding: 2.5rem;
                margin-top: 2rem;
                margin-bottom: 2rem;
                flex: 1;
            }

            /* BOTONES ESTILIZADOS */
            .btn {
                border-radius: 8px;
                transition: 0.3s;
            }

            /* FOOTER OSCURO */
            footer {
                background-color: var(--dark-bg);
                color: #adb5bd;
                padding: 1.5rem 0;
                text-align: center;
            }
            /* PAGINADOR */
            .pagination .page-link {
                color: var(--dark-color);
                border: none;
                margin: 0 3px;
                border-radius: 8px !important;
                transition: 0.3s;
            }

            .pagination .page-item.active .page-link {
                background-color: var(--primary-color);
                color: white;
                box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
            }

            .pagination .page-link:hover {
                background-color: #e9ecef;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="fas fa-film me-2"></i>SakilaApp
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/Films"><i class="fas fa-video me-1"></i>Películas</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Actors"><i class="fas fa-users me-1"></i>Actores</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Categories"><i class="fas fa-tags me-1"></i>Categorías</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Customers"><i class="fas fa-user-tag me-1"></i>Clientes</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Rentals"><i class="fas fa-key me-1"></i>Alquileres</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Stores"><i class="fas fa-store me-1"></i>Tiendas</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Inventories"><i class="fas fa-boxes me-1"></i>Inventarios</a></li>
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-outline-light btn-sm px-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <form method="post" action="/Account/Logout" class="px-3 py-1">
                                        <button type="submit" class="btn btn-danger btn-sm w-100">
                                            <i class="fas fa-sign-out-alt me-1"></i> Salir
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Account/Login">Iniciar sesión</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm ms-lg-2 px-3" href="/Account/Register">Registrarse</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container main-container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4">
                <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show container mt-3" role="alert">
                <strong><i class="fas fa-check-circle me-2"></i>LOGRADO</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </div>

    <footer>
        <div class="container">
            <p class="mb-0">&copy; 2026 - SakilaApp | <span class="text-white-50">Gestión Cinematográfica</span></p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>